{
  "name": "chomp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A maze-chase arcade game, built as a working demo of an AI-native SDLC on GitHub.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ragmha/chomp.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "verify": "npm run typecheck && npm run lint && npm test",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "lefthook": "^2.1.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  }
}
